# Copy to .env for local dev. In production set these as environment variables on the host.
ENV=dev                         # dev | staging | prod
BASE_URL=http://localhost:8000  # prod: the public https URL of this API (used in image links)
SECRET_KEY=                     # prod: 40+ random chars. python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://closeteye:closeteye@db:5432/closeteye

# Firebase Admin key (verifies phone sign in). Use ONE of these. Never commit the key.
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON=  # prod: paste the whole key JSON on one line

OPENAI_API_KEY=

# Cost controls (the app is free)
DAILY_AI_BUDGET_USD=15
QUOTA_TRYON_PER_DAY=3
QUOTA_FLATLAY_PER_DAY=5
QUOTA_EXTRACT_PER_DAY=15
QUOTA_ITEM_UPLOADS_PER_DAY=60
QUOTA_LLM_PER_DAY=30

SUPPORT_EMAIL=support@drape.app
UPLOAD_DIR=uploads
DEBUG=false
